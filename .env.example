# Zugang zum Stackit AI Model Serving (OpenAI-kompatibel).
# Kopiere diese Datei nach `.env` und trage deine echten Werte ein.
# Die tatsächliche `.env` ist per .gitignore ausgeschlossen.

OPENAI_API_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud
OPENAI_API_KEY=<dein_stackit_api_key>
