# Secrets
.env
.env.*
!.env.example

# Original-Vergabeunterlagen (FITKO CXP4DM2MNHA) — NICHT im öffentlichen Repo.
# Diese sind zwar per §41 VgV frei abrufbar, aber Wiederveröffentlichung
# ist nicht durch den Vortragskontext gedeckt. Zieht euch die PDFs selbst
# mit `scripts/download-fitko.sh` vom DTVP.
demo-material/fitko/
demo-material/fitko-text/

# Foliendateien bleiben lokal — nur der PDF-Export kommt später ins Repo
*.pptx
*.ppt
*.key
*.odp
# (PDF ist NICHT ignoriert; folien.pdf o.ä. kann eingecheckt werden)

# Ephemere Logs/Statusdateien aus Batch-Läufen
demo-material/**/_batch.*
demo-material/**/_halluzination-hunt.log
demo-material/**/_tmp-*.md
videos/_record.log

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Sachsen-Fundsachen Vergabe-PDFs — selbes Argument wie bei FITKO.
demo-material/sachsen-fundsachen/
